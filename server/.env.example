# MedGuard Server Configuration (.env.example)
# Copy this file to .env or server/.env and fill in real values.
# DO NOT commit real secrets to source control.

# Server HTTP Port
PORT=5000

# Application Database Connection String
# Connects as the non-owner, non-superuser role 'medguard_app'
DATABASE_URL=postgresql://medguard_app:YOUR_PASSWORD_HERE@localhost:5432/medguard

# JWT Secrets for Access and Refresh Tokens (use 32+ character random strings)
JWT_ACCESS_SECRET=replace_with_a_secure_random_32_character_string_for_access
JWT_REFRESH_SECRET=replace_with_a_secure_random_32_character_string_for_refresh

# Token Expiration Windows
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=http://localhost:5173

